# ---------------------------------------------------------------------------
# Required: Gemini (the synthesis engine)
# Get a key at https://aistudio.google.com/apikey
# Without this the API still runs, but falls back to the deterministic
# rule-based analyst and produces no narrative synthesis.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Optional: research tool API keys
# Every tool works without these, but with lower rate limits or via a
# web-search fallback instead of the official API.
# ---------------------------------------------------------------------------
# News: falls back to the Google News RSS feed when both are unset
NEWS_API_KEY=
GNEWS_API_KEY=
# Academic: raises the Semantic Scholar rate limit; arXiv is the fallback
SEMANTIC_SCHOLAR_API_KEY=

# Patents: EPO Open Patent Services is the only official API still reachable
# that indexes Indian publications. PatentsView was retired (its host no longer
# resolves) and the USPTO Open Data Portal is US-only, so these two variables
# are what enable authoritative Indian patent coverage.
#
# Without them the tool degrades to the keyless Google Patents data endpoint,
# and then to a labelled Google Patents web search. Both still work, but the
# keyless endpoint throttles aggressively and returns fewer fields.
#
# Free self-service registration: https://developers.epo.org
EPO_OPS_KEY=
EPO_OPS_SECRET=

# Model hub: optional. Raises the Hugging Face rate limit and exposes gated
# repositories. Model traction lookups work fully without it.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
# Set to "true" only for local development
UVICORN_RELOAD=false

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated exact origins to allow, in addition to localhost defaults
ALLOWED_ORIGINS=
# Regex for deployment origins. Defaults to this project's Vercel URLs:
#   ^https://runtime-x[a-z0-9-]*\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# ---------------------------------------------------------------------------
# Long-term memory
# ---------------------------------------------------------------------------
# Absolute path for the SQLite memory database. On hosts with an ephemeral
# filesystem (e.g. Render's default disk) point this at a mounted persistent
# disk, otherwise scan memory resets on every deploy.
MEMORY_DB_PATH=
